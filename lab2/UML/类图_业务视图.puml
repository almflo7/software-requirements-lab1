@startuml
title 外卖点餐与配送系统：业务视图
top to bottom direction
skinparam defaultFontName Microsoft YaHei

enum RoleType {
  CUSTOMER
  MERCHANT
  COURIER
  ADMIN
}

package "账号与权限" {
  class IdentityService <<Identity and Access>> {
    +registerCustomer(phone: String): Account
    +authenticate(accountId: String): Boolean
    +submitApplication(account: Account, type: String): ApprovalRequest
    +reviewApplication(admin: Account, request: ApprovalRequest, approved: Boolean): void
    +deactivate(admin: Account, account: Account): void
  }
  class Account {
    -accountId: String
    -role: RoleType
    -phone: String
    -status: String
    +isActive(): Boolean
  }
  class ApprovalRequest {
    -requestId: String
    -requestType: String
    -submittedAt: DateTime
    -reviewStatus: String
    -processedAt: DateTime
    +recordDecision(approved: Boolean): void
  }
  class CustomerAddress {
    -addressId: String
    -recipient: String
    -phone: String
    -addressText: String
    -deliveryArea: String
    +validateDeliveryArea(): Boolean
  }
}

package "店铺与菜品" {
  class CatalogService <<Store and Menu>> {
    +updateStore(merchant: Account, store: Store): void
    +updateMenuItem(merchant: Account, item: MenuItem): void
  }
  class SearchService <<Search>> {
    +findStores(keyword: String): Store[]
    +findMenuItems(keyword: String, category: String, minPrice: Decimal, maxPrice: Decimal): MenuItem[]
  }
  class Store {
    -storeId: String
    -name: String
    -description: String
    -businessHours: String
    -businessStatus: String
    +setBusinessStatus(status: String): void
  }
  class MenuItem {
    -itemId: String
    -name: String
    -category: String
    -currentPrice: Decimal
    -availableQuantity: Integer
    -listingStatus: String
    +updatePrice(price: Decimal): void
    +setListingStatus(status: String): void
  }
}

package "选餐与结算" {
  class CartService <<Cart>> {
    +refreshPrices(cart: Cart): void
    +confirmCheckout(customer: Account, cart: Cart): CheckoutConfirmation
  }
  class Cart {
    -cartId: String
    -foodAmount: Decimal
    -deliveryFee: Decimal
    -totalAmount: Decimal
    +changeQuantity(): void
    +recalculate(): void
    +addItem(item: MenuItem, quantity: Integer): void
  }
  class CartItem {
    -quantity: Integer
    -lastShownUnitPrice: Decimal
  }
  class CheckoutConfirmation {
    -confirmationId: String
    -confirmedAt: DateTime
    -latestPriceConfirmed: Boolean
    +confirmLatestPrice(): void
  }
}

package "订单与快照" {
  class OrderService <<Order>> {
    +submit(customer: Account, confirmation: CheckoutConfirmation): Order
    +requestTransition(actor: Account, order: Order, nextStatus: String): Boolean
  }
  class InventoryService <<Inventory>> {
    +reserve(order: Order): Boolean
    +restoreOnCancellation(order: Order): void
  }
  class Order {
    -orderId: String
    -storeNameSnapshot: String
    -status: String
    -foodAmount: Decimal
    -deliveryFee: Decimal
    -totalAmount: Decimal
    -placedAt: DateTime
    -completedAt: DateTime
    -customerNote: String
    +applyTransition(nextStatus: String): void
  }
  class OrderItemSnapshot {
    -itemName: String
    -unitPrice: Decimal
    -quantity: Integer
    -subtotal: Decimal
  }
  class DeliveryInfoSnapshot {
    -recipient: String
    -addressText: String
    -phone: String
  }
  class StockReservation {
    -reservationId: String
    -quantity: Integer
    -restoreStatus: String
    +markRestored(): void
  }
}

package "付款、取消与争议" {
  class PaymentService <<Mock Payment>> {
    +requestPayment(customer: Account, order: Order): PaymentRecord
    +handlePaymentResult(record: PaymentRecord): void
    +startFullRefund(order: Order): RefundRecord
    +handleRefundResult(record: RefundRecord): void
  }
  class CancellationService <<Cancellation, Refund and Dispute>> {
    +directCancel(customer: Account, order: Order): void
    +requestCancellation(customer: Account, order: Order): CancellationRequest
    +reviewCancellation(actor: Account, request: CancellationRequest): void
    +resolveDispute(admin: Account, dispute: DisputeCase): void
  }
  class PaymentRecord {
    -paymentId: String
    -requestId: String
    -result: String
    -resultAt: DateTime
    +recordResult(result: String): void
  }
  class CancellationRequest {
    -requestId: String
    -reason: String
    -submittedAt: DateTime
    -result: String
    -processedAt: DateTime
    +approve(): void
    +reject(): void
  }
  class RefundRecord {
    -refundId: String
    -amount: Decimal
    -initiatedAt: DateTime
    -result: String
    -failureReason: String
    +recordResult(result: String): void
  }
  class DisputeCase {
    -caseId: String
    -reason: String
    -decision: String
    -processedAt: DateTime
    +recordDecision(decision: String): void
  }
}

package "履约配送" {
  class MerchantFulfillmentService <<Merchant Fulfillment>> {
    +acceptOrder(merchant: Account, order: Order): void
    +rejectOrder(merchant: Account, order: Order, reason: String): void
    +finishPreparation(merchant: Account, order: Order): void
  }
  class DeliveryService <<Manual Delivery>> {
    +assign(admin: Account, order: Order, courier: Account): DeliveryTask
    +reassign(admin: Account, task: DeliveryTask, courier: Account): AssignmentRecord
    +respond(courier: Account, task: DeliveryTask, accepted: Boolean): void
    +confirmPickup(courier: Account, task: DeliveryTask): void
    +confirmDelivery(courier: Account, task: DeliveryTask): void
  }
  class DeliveryExceptionService <<Delivery Exception>> {
    +report(courier: Account, task: DeliveryTask, reason: String): DeliveryException
    +decide(admin: Account, exception: DeliveryException, decision: String): void
  }
  class DeliveryTask {
    -taskId: String
    -assignedAt: DateTime
    -result: String
    +setCurrentCourier(courier: Account): void
    +markAccepted(): void
    +markPickedUp(): void
    +markDelivered(): void
  }
  class AssignmentRecord {
    -recordId: String
    -adminAccountId: String
    -previousCourierId: String
    -newCourierId: String
    -assignedAt: DateTime
    -handoverResult: String
    +confirmHandover(): void
  }
  class DeliveryException {
    -exceptionId: String
    -reason: String
    -contactRecord: String
    -reportedAt: DateTime
    -decisionAdminId: String
    -adminDecision: String
    +recordContact(result: String): void
    +recordDecision(decision: String): void
  }
}

package "公共支撑" {
  class NotificationService <<Notification>> {
    +notifyOrderChange(order: Order): NotificationRecord[]
    +retry(record: NotificationRecord): void
  }
  class ReportingService <<Query and Reporting>> {
    +getOrderHistory(account: Account): Order[]
    +getStoreOrderHistory(merchant: Account, store: Store): Order[]
    +getCourierTaskHistory(courier: Account): DeliveryTask[]
    +getMerchantSummary(merchant: Account, store: Store): StatisticsResult
    +getPlatformSummary(admin: Account): StatisticsResult
  }
  class StatisticsResult <<derived>> {
    -orderCount: Integer
    -revenue: Decimal
    -refundAmount: Decimal
    -difference: Decimal
    -hotItemQuantities: String
  }
  class AuditService <<Audit Log>> {
    +append(operator: Account, content: String): AuditLog
    +query(viewer: Account, order: Order): AuditLog[]
  }
  class SchedulerService <<Scheduled Jobs>> {
    +schedule(type: String, targetId: String): ScheduledJob
    +runDueJobs(): void
  }
  class NotificationRecord {
    -notificationId: String
    -content: String
    -sendResult: String
    -retryCount: Integer
    -nextRetryAt: DateTime
    +recordAttempt(result: String): void
  }
  class AuditLog {
    -logId: String
    -occurredAt: DateTime
    -content: String
    -result: String
    -failureReason: String
    -businessType: String
    -businessId: String
  }
  class ScheduledJob {
    -jobId: String
    -jobType: String
    -businessType: String
    -businessId: String
    -dueAt: DateTime
    -result: String
    +recordExecution(result: String): void
  }
}

package "数据存储" {
  interface DataAccess <<Data Access>> {
    +save(recordType: String, recordId: String, data: Object): void
    +load(recordType: String, recordId: String): Object
  }
}

Account ..> RoleType : 角色取值
Account "1" -- "0..*" ApprovalRequest : 申请人
Account "0..1" -- "0..*" ApprovalRequest : 审核管理员
Account "1" -- "0..*" CustomerAddress : 保存地址
Account "1" -- "0..*" Store : 负责经营
Store "1" *-- "0..*" MenuItem : 菜品目录
Account "1" -- "0..*" Cart : 顾客
Store "1" -- "0..*" Cart : 单店选择
Cart "1" *-- "0..*" CartItem : 包含
CartItem "0..*" --> "1" MenuItem : 当前菜品
Cart "1" -- "0..*" CheckoutConfirmation : 结算确认
CheckoutConfirmation "1" -- "0..1" Order : 生成
Account "1" -- "0..*" Order : 顾客
Store "1" -- "0..*" Order : 所属店铺
Order "1" *-- "1..*" OrderItemSnapshot : 固化菜品
Order "1" *-- "1" DeliveryInfoSnapshot : 固化收货信息
CustomerAddress ..> DeliveryInfoSnapshot : 生成时取值
Order "1" -- "1..*" StockReservation : 占用
StockReservation "0..*" --> "1" MenuItem : 占用菜品
Order "1" -- "0..*" PaymentRecord : 付款尝试
Order "1" -- "0..*" CancellationRequest : 取消申请
Order "1" -- "0..1" RefundRecord : 有效退款
RefundRecord "0..1" --> "1" PaymentRecord : 原付款
Order "1" -- "0..*" DisputeCase : 争议
Account "1" -- "0..*" CancellationRequest : 申请人
Account "0..1" -- "0..*" CancellationRequest : 处理人
Account "1" -- "0..*" DisputeCase : 提出人
Account "0..1" -- "0..*" DisputeCase : 决定管理员
DisputeCase --> DeliveryException : 引用事实
Order "1" -- "0..1" DeliveryTask : 配送任务
DeliveryTask "1" *-- "0..*" AssignmentRecord : 派单历史
DeliveryTask "1" -- "0..*" DeliveryException : 异常记录
Account "0..1" -- "0..*" DeliveryTask : 当前配送人员
Order "1" -- "0..*" NotificationRecord : 状态通知
Account "1" -- "0..*" NotificationRecord : 接收人
Account "0..1" -- "0..*" AuditLog : 操作者
ScheduledJob "0..*" --> "0..1" Order
ScheduledJob "0..*" --> "0..1" CancellationRequest
ScheduledJob "0..*" --> "0..1" RefundRecord
ScheduledJob "0..*" --> "0..1" NotificationRecord

@enduml
