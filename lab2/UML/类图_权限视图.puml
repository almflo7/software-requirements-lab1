@startuml
title 外卖点餐与配送系统：权限视图
left to right direction
skinparam defaultFontName Microsoft YaHei

class Account {
  -accountId: String
  -role: RoleType
  -phone: String
  -status: String
  +isActive(): Boolean
}

enum RoleType {
  CUSTOMER
  MERCHANT
  COURIER
  ADMIN
}

class ApprovalRequest {
  -reviewStatus: String
}

class Store {
  -storeId: String
}

class Order {
  -orderId: String
  -status: String
}

class DeliveryTask {
  -taskId: String
}

class AccessPolicy <<service>> {
  +canReview(actor: Account, request: ApprovalRequest): Boolean
  +canManageStore(actor: Account, store: Store): Boolean
  +canSubmitOrder(actor: Account, store: Store): Boolean
  +canProcessOrder(actor: Account, order: Order): Boolean
  +canDispatch(actor: Account, task: DeliveryTask): Boolean
  +canHandleDelivery(actor: Account, task: DeliveryTask): Boolean
  +canViewContact(actor: Account, order: Order): Boolean
  +canViewAuditLog(actor: Account): Boolean
}

Account ..> RoleType : 角色取值
Account "1" -- "0..*" ApprovalRequest : 申请人
Account "0..1" -- "0..*" ApprovalRequest : 审核管理员
Account "1" -- "0..*" Store : 经营者
Account "1" -- "0..*" Order : 顾客
Account "0..1" -- "0..*" DeliveryTask : 当前配送人员
Store "1" -- "0..*" Order : 所属店铺
Order "1" -- "0..1" DeliveryTask : 配送任务
AccessPolicy ..> Account : 校验角色与状态
@enduml
